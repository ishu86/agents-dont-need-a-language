+// Cancels an order. Open orders just close; paid or partly refunded orders are
+// refunded in full first.
+export function cancelOrder(orderId) {
+  const order = getOrder(orderId);
+  if (!order) throw `not_found: unknown order ${orderId}`;
+  if (order.status === "paid" || order.status === "partially_refunded") refund(orderId);
+  else if (order.status !== "open") throw `bad_state: order ${orderId} is ${order.status}`;
+  const wasStatus = order.status;
+  order.status = "cancelled";
+  record("order_cancelled", orderId, wasStatus);
+  const customer = getCustomer(order.customerId);
+  if (customer) queueEmail(customer, "order_cancelled", orderId);
+  return order;
+}
