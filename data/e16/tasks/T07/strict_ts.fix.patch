 }
+
+/**
+ * Cancels an order. Open orders just close (nothing was reserved). Paid or partly refunded
+ * orders first get a refund of everything left. Audits and emails the customer.
+ */
+export function cancelOrder(ctx: Ctx, orderId: string): Result<Order> {
+  const order = getOrder(ctx.db, orderId);
+  if (!order) return err("not_found", `unknown order ${orderId}`);
+  if (order.status === "paid" || order.status === "partially_refunded") {
+    const refunded = refund(ctx, orderId);
+    if (!refunded.ok) return refunded;
+  } else if (order.status !== "open") {
+    return err("bad_state", `order ${orderId} is ${order.status}`);
+  }
+  const current = getOrder(ctx.db, orderId) ?? order;
+  const cancelled: Order = { ...current, status: "cancelled" };
+  ctx.db.orders.set(orderId, cancelled);
+  record(ctx.log, ctx.clock, "order_cancelled", orderId, current.status);
+  const customer = getCustomer(ctx.db, order.customerId);
+  if (customer) queueEmail(ctx, customer, "order_cancelled", orderId);
+  return ok(cancelled);
+}
