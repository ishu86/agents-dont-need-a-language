+
+/** Adds `delta` (may be negative) loyalty points to the stored customer, never below 0. */
+export function adjustPoints(db: Db, id: string, delta: number): void {
+  const c = db.customers.get(id);
+  if (!c) return;
+  db.customers.set(id, { ...c, points: Math.max(0, c.points + delta) });
 }
