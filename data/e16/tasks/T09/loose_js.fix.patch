diff -ruN a/src/rules/clearance.js b/src/rules/clearance.js
--- a/src/rules/clearance.js	1970-01-01 05:30:00
+++ b/src/rules/clearance.js	2026-10-30 13:51:51
@@ -0,0 +1,11 @@
+import { state } from "../state.js";
+import { percentOf } from "../money.js";
+import { registerRule } from "../pricing.js";
+
+registerRule("clearance", ({ lines }) => {
+  let total = 0;
+  for (const line of lines) {
+    if (line.category === "clearance") total += percentOf(line.lineCents, state.config.clearanceBps);
+  }
+  return total;
+});
