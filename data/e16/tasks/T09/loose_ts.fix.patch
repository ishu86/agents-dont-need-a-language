--- a/src/rules/clearance.ts	1970-01-01 05:30:00
+++ b/src/rules/clearance.ts	2026-10-30 13:51:51
@@ -0,0 +1,11 @@
+import { state } from "../state.ts";
+import { percentOf } from "../money.ts";
+import { registerRule } from "../pricing.ts";
+
+registerRule("clearance", ({ lines }: any) => {
+  let total = 0;
+  for (const line of lines) {
+    if (line.category === "clearance") total += percentOf(line.lineCents, state.config.clearanceBps);
+  }
+  return total;
+});
