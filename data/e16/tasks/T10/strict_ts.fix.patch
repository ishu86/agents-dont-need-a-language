+
+/** Flags (or unflags) a customer as tax exempt in `ctx.db` and audits the change. */
+export function setTaxExempt(ctx: Ctx, id: string, exempt: boolean): Result<Customer> {
+  const c = ctx.db.customers.get(id);
+  if (!c) return err("not_found", `unknown customer ${id}`);
+  const updated: Customer = { ...c, taxExempt: exempt };
+  ctx.db.customers.set(id, updated);
+  record(ctx.log, ctx.clock, "tax_exempt_set", id, String(exempt));
+  return ok(updated);
 }
 
