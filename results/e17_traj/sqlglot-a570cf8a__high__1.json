    "path": "sqlglot/parsers/bigquery.py",
    "old": "    def _parse_subquery(\n        self, this: exp.Expr | None, parse_alias: bool = True\n    ) -> exp.Subquery | None:\n        if parse_alias:\n            index = self._index\n            _, side, _ = self._parse_join_parts()\n            is_set_operation = side and self._match_set(self.SET_OPERATIONS, advance=False)\n            self._retreat(index)\n\n            if is_set_operation:\n                parse_alias = False\n\n        return super()._parse_subquery(this, parse_alias=parse_alias)\n\n    # BigQuery does not allow ASC/DESC to be used as an identifier, allows GRANT as an identifier\n",
    "new": "    def _parse_alias(self, this: exp.Expr | None, explicit: bool = False) -> exp.Expr | None:\n        if not explicit:\n            index = self._index\n            _, side, _ = self._parse_join_parts()\n            is_set_operation = side and self._match_set(self.SET_OPERATIONS, advance=False)\n            self._retreat(index)\n\n            if is_set_operation:\n                return this\n\n        return super()._parse_alias(this, explicit=explicit)\n\n    # BigQuery does not allow ASC/DESC to be used as an identifier, allows GRANT as an identifier\n"
