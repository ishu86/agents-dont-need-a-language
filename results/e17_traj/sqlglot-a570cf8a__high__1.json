   "tool": "edit_file",
   "args": {
    "path": "sqlglot/parsers/bigquery.py",
    "old": "    def _parse_alias(self, this: exp.Expr | None, explicit: bool = False) -> exp.Expr | None:\n        if not explicit:\n            index = self._index\n            _, side, _ = self._parse_join_parts()\n            is_set_operation = side and self._match_set(self.SET_OPERATIONS, advance=False)\n            self._retreat(index)\n\n            if is_set_operation:\n                return this\n\n        return super()._parse_alias(this, explicit=explicit)\n",
    "new": "    def _is_set_operation_ahead(self) -> tuple[bool, bool]:\n        index = self._index\n        _, side, _ = self._parse_join_parts()\n        is_set_operation = self._match_set(self.SET_OPERATIONS, advance=False)\n        self._retreat(index)\n        return bool(side), is_set_operation\n\n    def _parse_alias(self, this: exp.Expr | None, explicit: bool = False) -> exp.Expr | None:\n        has_side, is_set_operation = self._is_set_operation_ahead()\n        if not explicit and has_side and is_set_operation:\n            return this\n\n        expression = super()._parse_alias(this, explicit=explicit)\n\n        # Keep an alias on a parenthesized query attached to the subquery when it is a\n        # set-operation operand, rather than wrapping the subquery in an Alias node.\n        if isinstance(this, exp.Subquery) and isinstance(expression, exp.Alias):\n            _, is_set_operation = self._is_set_operation_ahead()\n            if is_set_operation:\n                this.set(\"alias\", exp.TableAlias(this=expression.args[\"alias\"]))\n                return this\n\n        return expression\n"
   },
