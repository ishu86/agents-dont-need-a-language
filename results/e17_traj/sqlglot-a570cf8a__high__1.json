    "new": "    ADJACENT_STRINGS_CANNOT_BE_CONNECTED: t.ClassVar = True\n\n    def _parse_subquery(\n        self, this: exp.Expr | None, parse_alias: bool = True\n    ) -> exp.Subquery | None:\n        if parse_alias:\n            index = self._index\n            _, side, _ = self._parse_join_parts()\n            is_set_operation = side and self._match_set(self.SET_OPERATIONS, advance=False)\n            self._retreat(index)\n\n            if is_set_operation:\n                parse_alias = False\n\n        return super()._parse_subquery(this, parse_alias=parse_alias)\n\n    # BigQuery does not allow ASC/DESC to be used as an identifier, allows GRANT as an identifier\n"
