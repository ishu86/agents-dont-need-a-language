    "new": "        # START is never treated as an implicit alias when followed by WITH, since that\n        # would swallow the beginning of a START WITH ... CONNECT BY clause\n        if self._curr.text.upper() == \"START\" and self._next.text.upper() == \"WITH\":\n            return None\n\n        # FULL / LEFT can modify a set operation after a parenthesized query. Don't\n        # consume them as an implicit subquery alias in that position.\n        if self._curr.text.upper() in (\"FULL\", \"LEFT\") and (\n            self._next.text.upper() in (\"OUTER\", \"UNION\", \"EXCEPT\", \"INTERSECT\")\n            or self._curr.text.upper() == \"FULL\"\n            and self._next.token_type in self.SET_OPERATIONS\n        ):\n            return None\n"
